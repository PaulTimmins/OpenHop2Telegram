# --- OpenHop / MeshCore companion (TCP) ---
# Host and port of the OpenHop repeater's MeshCore TCP companion server.
# The MeshCore companion protocol default port is 4000.
OPENHOP_HOST=127.0.0.1
OPENHOP_PORT=4000

# Which channel to relay. Resolved by NAME first (matched case-insensitively
# against the channels configured on the node). If the name can't be resolved,
# the INDEX below is used as a fallback.
MESH_CHANNEL_NAME=General
MESH_CHANNEL_INDEX=0

# --- Telegram ---
# From @BotFather, and the target chat id (user, group, or channel).
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=-1001234567890

# --- Relay behaviour ---
# Name this relay uses in its own status messages. Matters when several relays
# post into one chat, since otherwise they're indistinguishable.
# Defaults to the hostname.
RELAY_NAME=

# both | mesh_to_tg | tg_to_mesh
RELAY_DIRECTION=both

# Prefix added to messages relayed Telegram -> mesh (helps humans on the mesh
# see it came from Telegram). Set empty to disable.
TG_TO_MESH_PREFIX=[tg]

# Max characters per mesh transmission (LoRa payloads are small). A longer
# message is SPLIT across several, each marked (n/m) and carrying the sender,
# rather than truncated -- half a sentence on the mesh helps nobody.
MESH_MAX_CHARS=140

# Ceiling on how many transmissions one Telegram message may become, so a very
# long one can't monopolise a shared channel. Anything over is not sent, and
# the sender is told. 0 removes the limit.
MESH_MAX_PARTS=4

# Seconds between those transmissions. Back to back they hog the channel and
# collide more.
MESH_PART_DELAY=3

# --- New node / repeater alerts ---
# Post a Telegram message the first time a node is seen advertising.
NOTIFY_NEW_NODES=true

# Which node types to alert on: "all", or a comma-separated list of
# NONE, CLI, REP, ROOM, SENS (aliases: node, companion, repeater, room, sensor).
# e.g. NOTIFY_NODE_TYPES=repeater,room  -> infrastructure only, no handhelds.
NOTIFY_NODE_TYPES=all

# Where the list of already-announced nodes is kept, so restarts stay quiet.
SEEN_NODES_FILE=seen_nodes.json

# How often (seconds) to diff the node's contact list against the store, as a
# backstop for new-node alerts. Which push a node emits depends on its firmware
# and auto-add setting, so polling is what guarantees nothing is missed.
# 0 disables it and leaves detection to push notifications alone.
NODE_POLL_INTERVAL=300

# On the very first run the node's existing contacts are recorded silently
# (otherwise you'd get an alert per known node). Set false to skip the
# one-line "tracking N known nodes" summary posted at that point.
ANNOUNCE_SEED_SUMMARY=true

# --- Reconnection ---
# The relay retries forever, backing off from MIN to MAX seconds. (meshcore's
# own auto-reconnect gives up after a few fast tries, which isn't enough to
# survive the node being reconfigured or rebooted.)
RECONNECT_MIN_DELAY=5
RECONNECT_MAX_DELAY=300

# Seconds between liveness probes. A TCP session can stay open while the node
# stops answering, so silence alone isn't proof the link is healthy.
# This also acts as a keepalive: OpenHop hangs up on companion clients that go
# quiet (idle_timeout, typically 120s), and on an idle channel this probe is the
# only traffic. Keep it well below the node's idle timeout or you'll see the
# relay reconnect every couple of minutes. 0 disables it entirely.
HEALTHCHECK_INTERVAL=45

# Post to Telegram when the mesh link drops and when it comes back.
NOTIFY_CONNECTION_EVENTS=true

# --- Maintenance scripts ---
# Companion endpoint the scripts (sync_node_time.py, list_nodes.py) connect to.
# Leave blank to reuse OPENHOP_HOST/PORT above. Point it at its own endpoint --
# a second companion port, a proxy, another node -- to keep the scripts off the
# relay's message queue, since two clients on one endpoint split that queue.
TIMESYNC_HOST=
TIMESYNC_PORT=

# Where the optional relay handshake files live (relay.pid, mesh.pause,
# relay.released), used only when a script is run with --pause. Must match
# between the relay and the scripts.
LOCK_DIR=.

# --- Wardriver alerts ---
# Watch a channel for wardrivers announcing themselves and notify when one
# turns up that hasn't been heard for a while. Silently does nothing if the
# node has no such channel.
WARDRIVING_ENABLED=true
WARDRIVING_CHANNEL=wardriving

# Create #wardriving if missing. Off by default: wardriving is enabled by
# default, and adding a channel to your radio on upgrade shouldn't be silent.
WARDRIVING_CREATE_CHANNEL=false

# Only alert if this wardriver has been quiet for at least this long, so an
# ongoing session doesn't produce a message per transmission. 3600 = one hour.
WARDRIVING_QUIET_SECONDS=3600

# Remembers when each wardriver was last heard, so a restart doesn't re-alert.
WARDRIVING_LOG_FILE=wardrivers.json

# The on-air format isn't specified anywhere, so by default the sender's label
# is taken from the message with any trailing "lat lon" read as a position.
# If your local traffic looks different, set a regex with named groups
# (name, id, lat, lon) -- run with LOG_LEVEL=DEBUG to see the raw messages.
# e.g. WARDRIVING_PATTERN=^WD\|(?P<id>\w+)\|(?P<name>[^|]+)$
WARDRIVING_PATTERN=

# Blunt fallback: never alert more often than this many seconds, whoever it is.
# Useful when senders can't be told apart (a token that changes per transmission
# makes every ping look like a new wardriver). 0 = off, rely on the per-wardriver
# quiet period above.
WARDRIVING_MIN_ALERT_GAP=0

# --- Chat commands ---
# /nodes, /battery, /telemetry, /help, answered in the configured chat.
# Anyone who can post there can run them; all are read-only except the airtime
# /telemetry spends asking a node for a fresh reading.
COMMANDS_ENABLED=true

# Metrics log that /battery reads. Point it at the same file the clock checker
# writes with --metrics, or the graph will have nothing to plot.
METRICS_CSV=metrics.csv

# Node list the commands read admin passwords from, for /telemetry. A node with
# no password there is queried as a guest with a blank one, which still returns
# whatever it's willing to share.
TIME_SYNC_CONFIG=time_sync.json

# --- Propagation testing ---
# Beacon a tiny probe on a dedicated channel and log the probes other relays
# send, to measure link reliability over time. Off by default: unlike the rest
# of this file it transmits on a schedule. /proptest reports what it found.
# Every relay needs the same channel name AND key for this to mean anything.
PROPTEST_ENABLED=false
PROPTEST_CHANNEL=tgmeshtest

# Create the channel if the node doesn't have it, in the first free slot. A
# hashtag channel's key is derived from its name (SHA-256 of "#name", first 16
# bytes), so every relay creating it independently ends up with the same key
# and no secret has to be shared. An existing channel is never overwritten.
PROPTEST_CREATE_CHANNEL=true

# Seconds between probes. Each one is airtime on a shared channel, so with
# several relays keep it generous.
PROPTEST_INTERVAL=300

# How this relay identifies itself in probes. Defaults to the hostname.
PROPTEST_ID=

# Where heard probes are logged, and where /proptest reads them from.
PROPTEST_LOG=proptest.csv

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
