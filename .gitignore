# Secrets / local config — never commit these.
# (.env.example is intentionally NOT ignored; it's the template.)
.env
.env.*
!.env.example

# Runtime state (which nodes have already been announced)
seen_nodes.json

# Node list for the clock checker — contains admin passwords.
# (time_sync.example.json is the tracked template.)
time_sync.json

# Collected metrics
metrics.csv
*.csv

# Virtualenvs
.venv/
venv/
env/
ENV/

# Python bytecode / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Editors / OS cruft
.vscode/
.idea/
.DS_Store
